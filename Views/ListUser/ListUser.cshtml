@model IEnumerable<Project.Models.UserModel>

@{
    ViewBag.Title = "Danh sách user xử lí";
}

<div class="profile-container">
    <div class="profile-header">
        <div class="title-group">
            <h2>Danh sách hồ sơ</h2>

        </div>
        <div class="title-group">
            <h2>Danh sách user</h2>
        </div>
    </div>
    <div class="profile-table-container">
        <table class="profile-table">
            <thead>
                <tr>
                    <th>Mã User</th>
                    <th>Hồ sơ duyệt</th>
                    <th>Thời gian duyệt</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ID_User</td>
                        <td>@item.IdHoSo</td>
                        <td>@item.ThoiGianDuyet.ToString("dd/MM/yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    /* CSS tùy chỉnh - không ảnh hưởng đến layout */
    .profile-container {
        padding: 20px;
        font-family: Arial, sans-serif;
    }

    .profile-header {
        display: flex;
        justify-content: flex-start; /* Đảm bảo các phần tử bắt đầu từ bên trái */
        align-items: center;
        margin-bottom: 20px;
    }

        .profile-header .title-group {
            margin-right: 20px; /* Khoảng cách giữa hai tiêu đề */
        }

        .profile-header h2 {
            font-size: 20px;
            font-weight: bold;
            color: #333;
            margin: 0;
        }

    .profile-actions {
        display: flex;
        gap: 20px;
    }

    .profile-link {
        color: #0066cc;
        text-decoration: none;
        font-weight: normal;
        font-size: 14px;
    }

        .profile-link:hover {
            text-decoration: underline;
        }

    .profile-table-container {
        width: 100%;
        overflow-x: auto;
    }

    .profile-table {
        width: 100%;
        border-collapse: collapse;
    }

        .profile-table th {
            background-color: #f2f2f2;
            padding: 10px 15px;
            text-align: left;
            font-weight: bold;
            border-bottom: 2px solid #ddd;
        }

        .profile-table td {
            padding: 10px 15px;
            border-bottom: 1px solid #ddd;
        }

        .profile-table tr:last-child td {
            border-bottom: none;
        }

        .profile-table tr:hover {
            background-color: #f5f5f5;
        }
</style>