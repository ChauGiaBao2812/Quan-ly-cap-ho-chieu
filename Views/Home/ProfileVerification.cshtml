@{
    ViewBag.Title = "Xét duyệt hồ sơ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .info-box {
        background-color: #ffffff;
        padding: 30px;
        text-align: center;
        font-size: 1.5em;
        border-radius: 6px;
        margin-bottom: 20px;
        position: relative;
    }

        .info-box img {
            position: absolute;
            top: 10px;
            right: 10px;
            max-width: 40px;
            cursor: pointer;
        }

    .requirement-box {
        display: none;
        position: absolute;
        top: 60px;
        right: 10px;
        background-color: #fff;
        color: #000;
        border: 1px solid #333;
        border-radius: 6px;
        padding: 15px;
        font-size: 1em;
        width: 250px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        z-index: 10;
    }

        .requirement-box ul {
            padding-left: 20px;
            text-align: left;
        }

        .requirement-box button {
            margin-top: 10px;
            padding: 5px 10px;
            font-size: 0.9em;
            cursor: pointer;
        }

    .note-section {
        margin-bottom: 20px;
        text-align: center;
    }

        .note-section textarea {
            width: 100%;
            height: 80px;
            resize: none;
            padding: 10px;
            font-size: 1em;
            border-radius: 6px;
            border: 1px solid #999;
            word-wrap: break-word;
            white-space: pre-wrap;
        }

    .action-buttons {
        display: flex;
        justify-content: center;
        gap: 40px;
    }

        .action-buttons button {
            padding: 10px 30px;
            font-size: 1em;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }

    .invalid-btn {
        background-color: #fcf0c7;
    }

    .valid-btn {
        background-color: #fce1ac;
    }
</style>

<div class="verification-container">
    <div class="info-box">
        Thông tin từ người dùng

        <img src="@Url.Content("~/Img/error.png")" alt="Các yêu cầu xét duyệt" onclick="toggleRequirements()" />

        <div id="requirementBox" class="requirement-box">
            <strong>Các yêu cầu:</strong>
            <ul>
                <li>Yêu cầu 1</li>
                <li>Không</li>
                <li>Sai</li>
            </ul>
            <button onclick="toggleRequirements()">Đóng</button>
        </div>
    </div>

    <div class="note-section">
        <label>Ghi chú</label><br />
        <textarea placeholder="Nhập ghi chú ở đây..."></textarea>
    </div>

    <div class="action-buttons">
        <button class="invalid-btn">Không hợp lệ</button>
        <button class="valid-btn">Hợp lệ</button>
    </div>
</div>

@section Scripts {
    <script>
        function toggleRequirements() {
            const box = document.getElementById("requirementBox");
            box.style.display = (box.style.display === "block") ? "none" : "block";
        }
    </script>
}
